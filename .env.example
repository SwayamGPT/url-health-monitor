# Postgres (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass
POSTGRES_DB=urlmonitor

# Used when running the backend outside docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:pass@localhost:5432/urlmonitor

SECRET_KEY=change-me
# ACCESS_TOKEN_MINUTES=15     # short-lived access token
# REFRESH_TOKEN_DAYS=7        # rotating refresh token
# COOKIE_SECURE=true          # set when served over HTTPS

# LLM: set GROQ_API_KEY to use Groq, otherwise a local Ollama at http://localhost:11434 is used
GROQ_API_KEY=
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Shared /ask rate limiting across workers; without it each worker limits on its own
REDIS_URL=redis://localhost:6379/0
# ASK_RATE_LIMIT=10           # questions per user per minute

# Frontend (baked in at build time); backend is published on 8080 by docker-compose
VITE_API_URL=http://localhost:8080
